{
  "name": "ctool-cheat",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "src/electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:react\" \"npm:dev:electron\"",
    "dev:react": "vite",
    "dev:electron": "wait-on http://127.0.0.1:5173 && electron .",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "build:main": "esbuild src/electron/main.js --bundle --platform=node --target=node18 --format=esm --outdir=dist-electron",
    "dist": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "archiver": "^7.0.1"
  },
  "devDependencies": {
    "@ant-design/icons": "^5.6.1",
    "@eslint/js": "^9.30.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "antd": "^5.26.6",
    "concurrently": "^10.0.4",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^7.0.4",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.ctool-cheat.app",
    "productName": "CTool",
    "icon": "./logo.png",
    "files": [
      "src/electron/**/*",
      "src/engine/**/*",
      "src/utils/**/*",
      "dist-react/**/*",
      "logo.png",
      "package.json"
    ],
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "extraResources": [
      {
        "from": "tool_data",
        "to": "tool_data",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "inject",
        "to": "inject",
        "filter": [
          "cheat.js",
          "translator.js"
        ]
      }
    ],
    "electronDownload": {
      "cache": "C:\\Users\\Y7000\\AppData\\Local\\electron\\Cache"
    }
  }
}
